# ---------------------------------------------------------------------------
# IUM Fee Management - server environment
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string.
# Atlas dashboard -> Cluster -> Connect -> Drivers -> copy the SRV string.
# Remember to URL-encode special characters in the password.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ium_fees?retryWrites=true&w=majority"

# Database name used when the URI does not already include one.
MONGODB_DB_NAME="ium_fees"

# Resolvers used for the SRV lookup behind a `mongodb+srv://` URI when this
# machine's own resolver refuses the query (ECONNREFUSED). Applies to this
# process only, so a normal `mongodb://` URI is unaffected. Set to an empty
# value to disable the fallback.
DNS_FALLBACK_SERVERS="8.8.8.8,1.1.1.1"

# Port the Express API listens on.
PORT="5000"

# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:5173"

# Optional. When present, enables the Gemini-powered natural-language assistant.
# Without it the assistant falls back to the built-in rules-based engine.
GEMINI_API_KEY=""

NODE_ENV="development"
